{
  "name": "agents-md-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "prisma migrate deploy && npm run seed-aspects",
    "dev": "next dev",
    "prebuild": "npm run verify-registry && npm run test",
    "build": "next build",
    "prestart": "prisma migrate deploy && npm run seed-aspects",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx scripts/test-unit.ts",
    "verify-registry": "tsx scripts/verify-registry.ts",
    "seed-aspects": "tsx scripts/seed-aspects.ts",
    "postinstall": "prisma generate",
    "db:reset": "prisma migrate reset",
    "wasm:build": "asc assembly/cloud3d.ts --outFile public/wasm/cloud3d.wasm --optimize --noAssert"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^16.3.8",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "assemblyscript": "^0.28.20",
    "dotenv": "^18.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
