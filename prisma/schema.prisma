// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A project is a collection of repos the user adds as needed (infra,
// backend, frontend, mobile, or other — see src/lib/repos.ts for the kind
// list). Each repo generates its own AGENTS.md.
model Project {
  id          String             @id @default(cuid())
  name        String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  preferences AspectPreference[]
  repos       Repo[]
}

// One repo added under a project, e.g. "checkout-api" (kind: backend).
// `kind` matches a key in src/lib/repos.ts and drives which aspects/options
// apply (see aspectsForRepo / compatibleOptions), not the repo's identity.
model Repo {
  id          String             @id @default(cuid())
  projectId   String
  name        String
  kind        String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  preferences AspectPreference[]

  @@index([projectId])
}

// One row per (repo, aspect) - e.g. the "checkout-api" repo's "database"
// choices. `data` is a JSON blob keyed by field id from that aspect's
// registry definition, so adding a new field to an aspect never requires a
// migration.
model AspectPreference {
  id        String   @id @default(cuid())
  projectId String
  repoId    String
  aspectKey String
  data      String // JSON-encoded Record<string, string | string[]>
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repo      Repo     @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, aspectKey])
}

// This is our content, not the customer's — the aspect/card/field/option
// registry, migrated out of static TypeScript so it's a runtime-cached
// data load instead of something that requires a code deploy to change.
// src/lib/aspects/static-registry.ts remains the authored source (what a
// human edits and what scripts/verify-registry.ts validates); this table
// is re-seeded from it on every deploy (see package.json's `prestart`),
// never hand-edited directly. `scope` and `cards` are JSON, mirroring the
// exact nested shape of AspectDefinition.scope/cards in src/lib/aspects/
// types.ts — not normalized into separate tables, since this is read far
// more than written and the whole tree is cached in memory per process
// (see src/lib/aspects/registry.ts) rather than queried field-by-field.
model Aspect {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  icon      String
  tagline   String
  scope     String // JSON-encoded RepoKind[] | "all"
  order     Int // display order — replaces array position in the old static registry
  cards     String // JSON-encoded AspectCard[]
  updatedAt DateTime @updatedAt
}
